# .editorconfig — house style for dotfiles-Arch.
# https://editorconfig.org — honored natively by Neovim (this repo's editor),
# VS Code, and most others.
#
# core/.editorconfig sets `root = true`, but EditorConfig resolution walks UP from
# the file being edited, so that copy governs core/** and stops there. Without this
# file the repo's OWN surface (bootstrap.sh, os/*.zsh, the workflows) had no style
# at edit time. Kept deliberately in step with core/.editorconfig so a contributor
# moving between the two layers never retrains their fingers.
#
# As upstream: shfmt is NOT enforced (it would expand the deliberate compact
# one-liner style in bootstrap.sh's arg loop); the enforced check is shellcheck.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Shell — 2-space (shfmt intentionally not enforced; this just keeps edits 2-space).
[*.{sh,zsh}]
indent_size = 2

[*.{toml,yml,yaml,json,jsonc}]
indent_size = 2

# Markdown: trailing whitespace can be a meaningful hard line break.
[*.md]
trim_trailing_whitespace = false

# tmux/git configs follow upstream conventions.
[*.{conf,gitconfig}]
indent_size = 2

# wsl.conf is parsed at runtime by WSL — leave it alone. (ssh/config was here too until
# the client config moved into Core; core/ has its own .editorconfig.)
[wsl/wsl.conf]
indent_size = 2

# Makefile — recipe lines REQUIRE real tabs; override the global space rule.
[Makefile]
indent_style = tab
