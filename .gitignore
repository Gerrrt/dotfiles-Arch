# dotfiles-Arch/.gitignore
*.log
*.bak
*.pre-dotfiles.*
.DS_Store
.env
.env.*
!.env.example

# ── host-local shell overrides ────────────────────────────────────────────────
# v4 renamed the host override to 99-local.zsh AND moved it out of the repo — it
# lives at $ZDOTDIR/99-local.zsh (~/.config/zsh), never here. The old `zsh/local.zsh`
# rule that used to sit in this file matched a pre-v4 path that no longer exists in
# this repo at all (there is no top-level zsh/ directory). Kept as belt-and-braces
# in case anyone drops a copy in for reference.
zsh/99-local.zsh
zsh/local.zsh

# ── private SSH material — track ssh/config only, never keys ──────────────────
ssh/*
!ssh/config

# ── credentials / key material (defence in depth) ─────────────────────────────
# ssh/* above only covers that one directory. These catch key material dropped
# anywhere in the tree — the case a public repo cannot afford to get wrong.
*.pem
*.key
*.p12
*.pfx
*.age
*.gpg
*.asc
id_rsa*
id_ecdsa*
id_ed25519*
.netrc
.npmrc

# ── direnv ────────────────────────────────────────────────────────────────────
# install/packages.txt installs direnv and os/arch.zsh hooks it into every shell,
# so an .envrc here would be LOADED — and .envrc is a common home for exported
# tokens. Ignore the file and its cache.
.envrc
.direnv/

# ── tooling state ─────────────────────────────────────────────────────────────
.claude/settings.local.json
